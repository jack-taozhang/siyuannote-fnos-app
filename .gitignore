# ---- Python ----
__pycache__/
*.pyc
*.pyo

# ---- 打包与运行产物 ----
release/
*.fpk
.var/
var/
*.log

# ---- 本机生成的配置 / 凭据 ----
# OnlyOffice 的 JWT 密钥等由 cmd/main 在运行时写进 PKGETC（应用配置目录），
# 不随源码入库；仓库里只保留 manifest / cmd 里的默认值占位。
*.secret
*.pem
*.key
oo-secret

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# ---- 验证与临时产物 ----
.verify/
.scratch/
.tmp/
_tmp*/
*_tmp/